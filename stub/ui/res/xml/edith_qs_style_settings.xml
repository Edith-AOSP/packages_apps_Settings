<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="edith_qs_style_settings"
    android:title="@string/edith_qs_style_title">

    <org.edith.settings.notification.QsStylePreviewPreference
        android:key="edith_qs_style_preview"
        android:persistent="false"
        android:selectable="false" />

    <org.edith.settings.notification.QsStylePreference
        android:key="edith_qs_style"
        android:persistent="false" />

    <org.edith.settings.notification.QsColorSchemePreference
        android:key="edith_qs_color_scheme"
        android:persistent="false" />

    <!-- Debug: only shown when debug.enable_edith_tile_color is set. -->
    <Preference
        android:key="edith_tile_color_tuner_entry"
        android:title="@string/edith_tile_color_entry_title"
        android:summary="@string/edith_tile_color_entry_summary"
        android:fragment="org.edith.settings.notification.EdithQsTileColorFragment"
        android:persistent="false"
        settings:controller="org.edith.settings.notification.EdithTileColorEntryPreferenceController" />

</PreferenceScreen>
