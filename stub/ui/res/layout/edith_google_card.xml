<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="12dp"
    android:layout_marginBottom="12dp">

    <FrameLayout
        android:id="@+id/google_card"
        android:layout_width="match_parent"
        android:layout_height="128dp">

        <com.android.settings.edith.widget.WallpaperBlurView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/google_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/google_logo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/edith_ic_app_google" />

                <TextView
                    android:id="@+id/google_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:ellipsize="marquee"
                    android:textFontWeight="400"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/google_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/google_avatar"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
